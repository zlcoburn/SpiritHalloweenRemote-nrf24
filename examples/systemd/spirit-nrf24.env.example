HA_URL=http://homeassistant.local:8123
HA_TOKEN_FILE=/etc/spirit-nrf24/ha-token
PROP_BUTTON_PREFIX=prop_remote
# Optional existing input_boolean that should trigger A, then reset to off:
# PUMPKIN_TRIGGER_ENTITY=input_boolean.pumpkin_scare
NRF24_SPI_BUS=1
NRF24_SPI_DEVICE=0
NRF24_CE_GPIO=22
NRF24_GPIO_CHIP=0
NRF24_POWER=max
PROP_BURSTS=3
PROP_BURST_SECONDS=4
PROP_GAP_SECONDS=2
NRF24_LOCK_FILES=/tmp/nrf24.lock
# To coordinate with another radio's power lock, all programs must use this order:
# NRF24_LOCK_FILES=/tmp/cc1101.lock,/tmp/nrf24.lock
